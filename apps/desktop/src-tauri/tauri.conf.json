{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CM0304 Save Editor",
  "version": "0.4.0",
  "identifier": "com.cm0304.saveeditor",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "CM0304 Save Editor", "width": 1280, "height": 860, "minWidth": 960, "minHeight": 650 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": [] }
}
